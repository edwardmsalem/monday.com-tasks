# Server Configuration
PORT=3000

# Core API (centralized integration hub)
# Set these to use core-api instead of direct API calls
CORE_API_URL=http://core-api.railway.internal
CORE_API_KEY=your_core_api_key_here

# Monday.com API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_BOARD_ID=18383923820
MONDAY_FILE_COLUMN_ID=file_mkxv6aa0
MONDAY_SLACK_THREAD_COLUMN_ID=text_mkxxn3hz

# Slack API
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C08QCFC4Y0H
# Signing secret for verifying webhook requests (optional but recommended)
# Found in Slack App settings → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Supporter Notification Channels (optional)
# When a supporter is added to a task, notify them in their channel
# Checks primary first, then secondaries in order until found
# SLACK_SUPPORTER_PRIMARY_CHANNEL=C0123456789  # e.g., #operations
# SLACK_SUPPORTER_SECONDARY_CHANNELS=C1111111111,C2222222222  # e.g., #QuickTix-team,#ticket-associates

# ConvertAPI
CONVERTAPI_SECRET=your_convertapi_secret_here

# Anthropic (Claude AI for email analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Monday Board URL (for Slack links)
MONDAY_BOARD_URL=https://salemseats.monday.com/boards/18383923820

# Google Calendar (optional - set GOOGLE_CALENDAR_ENABLED=true to enable)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Option 1: Service Account (recommended for server automation)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Calendar API, create key (JSON), paste entire JSON here
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Option 2: OAuth (for personal use)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
